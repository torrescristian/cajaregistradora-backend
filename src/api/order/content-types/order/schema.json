{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "total_price": {
      "type": "decimal"
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "orden-item.order-item"
    },
    "additional_details": {
      "type": "string",
      "unique": false
    },
    "client": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::client.client"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "PENDING",
        "PAID",
        "CANCELLED",
        "WAITING_FOR_REFUND"
      ]
    },
    "address": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "discount": {
      "type": "component",
      "repeatable": true,
      "component": "discount.discount"
    }
  }
}
