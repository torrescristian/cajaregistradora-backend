{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "stock_per_product": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::stock-per-product.stock-per-product",
      "mappedBy": "product"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "products"
    },
    "store": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store",
      "inversedBy": "products"
    },
    "isService": {
      "type": "boolean",
      "default": false
    },
    "variants": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::variant.variant",
      "mappedBy": "product"
    },
    "public_price": {
      "type": "decimal"
    },
    "wholesale_price": {
      "type": "decimal"
    },
    "catalog_price": {
      "type": "decimal"
    },
    "special_price": {
      "type": "decimal"
    }
  }
}
