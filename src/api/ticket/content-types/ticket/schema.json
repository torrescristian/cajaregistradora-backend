{
  "kind": "collectionType",
  "collectionName": "tickets",
  "info": {
    "singularName": "ticket",
    "pluralName": "tickets",
    "displayName": "Ticket",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "totalPrice": {
      "type": "decimal"
    },
    "order": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::order.order"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "PAID",
        "REFUNDED",
        "WAITING_FOR_REFUND"
      ]
    },
    "cashBalance": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cash-balance.cash-balance",
      "inversedBy": "tickets"
    },
    "payments": {
      "type": "component",
      "repeatable": true,
      "component": "payment-type.payment"
    }
  }
}
